{
  "version": 8,
  "name": "Transit Map Style",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "https://compute.olie.science/versatiles/tiles/planet_transport_only/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "glyphs": "https://tiles.openstreetmap.us/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "layers": [
    {
      "id": "railways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "public_transport_tracks",
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#888888",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 1,
          14, ["match", ["get", "route"], "train", 4, 2]
        ]
      }
    },
    {
      "id": "transit-lines",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "public_transport_routes",
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": [
          "match", ["get", "route"],
            "ferry", "#008000",
            "train", "#444444",
            "subway", "#0000ff",
            "tram", "#ff0000",
            "bus", "#00aa00",
            "#888888"
        ],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 1,
          14, ["match", ["get", "route"], "train", 4, 2]
        ]
      }
    },
    {
      "id": "transit-nodes",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "public_transport_stops",
      "filter": ["==", ["geometry-type"], "Point"],
      "paint": {
        "circle-radius": 4,
        "circle-color": "#ffffff",
        "circle-stroke-width": 2,
        "circle-stroke-color": [
          "coalesce",
          ["case", ["has", "colour"], ["concat", "#", ["get", "colour"]], "#333333"],
          "#333333"
        ]
      }
    },
    {
      "id": "transit-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "public_transport_stops",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-size": 11,
        "text-variable-anchor": ["top", "bottom", "left", "right"],
        "text-radial-offset": 0.8
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "transit-line-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "public_transport_routes",
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "ref"],
        "text-font": ["Open Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          12, 9,
          16, 14
        ],
        "text-max-angle": 30,
        "symbol-spacing": 250,
        "text-letter-spacing": 0.1,
        "text-transform": "uppercase",
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "rgba(255, 255, 255, 0.9)",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    }
  ]
}
